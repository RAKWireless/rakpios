#!/bin/bash

# The portainer script was dropped in RAKPiOS 0.10.0. Portainer is now one of
# the services rakpios-cli can deploy, so all this does is point there - it is
# kept so that `portainer` does not just fail with "command not found" on
# images upgraded from earlier releases.

Y="\033[1;33m"
W="\e[0;39m"

echo
echo -e "${W}The 'portainer' command is no longer part of RAKPiOS."
echo -e "${W}Portainer is now one of the services deployed by ${Y}rakpios-cli${W}."
echo
echo -e "${W}Run ${Y}rakpios-cli${W} and pick 'Deploy services' -> 'Portainer'."
echo

exit 1
